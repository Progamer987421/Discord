# ─────────────────────────────────────────────
#  AppleMC Discord Bot — Environment Variables
# ─────────────────────────────────────────────

# Discord bot token
# Get it from: discord.com/developers/applications → Your App → Bot → Reset Token
DISCORD_TOKEN=your-bot-token-here

# Right-click your Discord server name → Copy Server ID
DISCORD_GUILD_ID=your-guild-id-here

# Right-click the channel you want bot to post in → Copy Channel ID
DISCORD_CHANNEL_ID=your-channel-id-here

# Your own Discord user ID (right-click your profile → Copy User ID)
# Only you will be able to run commands. Leave blank to allow anyone in the channel.
DISCORD_OWNER_ID=your-user-id-here

# Minecraft server settings
MC_HOST=play.applemc.fun
MC_PORT=25565
MC_VERSION=1.20.1
MC_PASSWORD=231182
